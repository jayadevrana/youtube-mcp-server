# Copy to .env and fill in. NEVER commit the real .env.
# These come from Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client ID (type: Desktop app).

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Where the OAuth refresh token is stored after you run authorize.py.
# Kept OFF the exFAT drive by default (secrets + AppleDouble cruft).
# YOUTUBE_TOKEN_PATH=~/.local/share/youtube-mcp/token.json

# Where pseudo-A/B thumbnail test state is stored.
# YOUTUBE_STATE_DIR=~/.local/share/youtube-mcp
